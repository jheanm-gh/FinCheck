# Lead delivery. Default 'log' needs no credentials and works out of the box.
#   log | resend | webhook
LEAD_DELIVERY=log

# LEAD_DELIVERY=resend
RESEND_API_KEY=
LEAD_TO_EMAIL=harika.vandermerwe@conceptwealth.com
LEAD_FROM_EMAIL="Climeo <noreply@climeo.dev>"

# LEAD_DELIVERY=webhook  (Zapier / Make / Google Sheets / CRM)
LEAD_WEBHOOK_URL=

# Adviser dashboard at /adviser/leads. Minimum 12 characters, or the gate stays shut.
ADVISER_PASSPHRASE=

# Supabase. Leave BLANK until the POPIA responsible party is settled —
# the dashboard shows an honest "no database connected" state without them.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
